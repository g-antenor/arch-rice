{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "color": {
      "1": "#8f8aac",
      "2": "#8f8aac"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#8f8aac",
      "title": "#8f8aac",
      "output": "white",
      "separator": "bright_black"
    },
    "key": {
      "width": 14
    }
  },
  "modules": [
    {
      "type": "os",
      "key": "  sistema"
    },
    {
      "type": "wm",
      "key": "  sessão"
    },
    {
      "type": "terminal",
      "key": "  terminal"
    },
    {
      "type": "memory",
      "key": "  memória"
    },
    {
      "type": "uptime",
      "key": "  uptime"
    }
  ]
}
